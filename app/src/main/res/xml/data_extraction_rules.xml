<?xml version="1.0" encoding="utf-8"?>
<!-- Only the database and preferences are listed. Shared preferences, which hold the HLC device id, are left out on purpose:
     restored onto another phone, that id would give two devices one clock identity. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="taski.db" />
        <include domain="file" path="datastore/user_preferences.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="taski.db" />
        <include domain="file" path="datastore/user_preferences.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
