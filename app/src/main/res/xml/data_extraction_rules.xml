<?xml version="1.0" encoding="utf-8"?>
<!-- The device id behind the HLC must never be restored onto another phone, or two devices would share one clock identity. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="taski.db" />
        <include domain="file" path="datastore/user_preferences.preferences_pb" />
        <exclude domain="sharedpref" path="taski_device.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="taski.db" />
        <include domain="file" path="datastore/user_preferences.preferences_pb" />
        <exclude domain="sharedpref" path="taski_device.xml" />
    </device-transfer>
</data-extraction-rules>
